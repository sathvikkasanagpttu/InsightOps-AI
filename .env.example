# ==============================================================================
# InsightOps AI — Enterprise Business Intelligence & AI Decision Platform
# Production Configuration & Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL in production, SQLite fallback in local dev)
# ------------------------------------------------------------------------------
# Production PostgreSQL:
DATABASE_URL=postgresql://insightops_user:insightops_secure_password_2026@localhost:5432/insightops_db
# Local SQLite Dev Default:
# DATABASE_URL=sqlite:///./data/insightops.db

# Database Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & BACKGROUND JOBS
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. ENTERPRISE AUTHENTICATION & CRYPTOGRAPHY (HS256 JWT)
# ------------------------------------------------------------------------------
# WARNING: Generate a cryptographically random 64-character hex key for production!
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=e4f9b2d8c1a740368819ab0d71a5c4e9f2a0b3c8d1e7f9a2b4c6e8d0f1a3b5c7
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
HMAC_SECRET_KEY=insightops_hmac_webhook_signing_secret_2026

# ------------------------------------------------------------------------------
# 6. EXTERNAL NOTIFICATIONS & WEBHOOKS
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=alerts@insightops.ai

# ------------------------------------------------------------------------------
# 7. OPTIONAL LLM & AI PROVIDERS (Deterministic fallback active by default)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

