# InsightOps AI — Environment Configuration

# Frontend API Target
VITE_API_URL=http://localhost:8000

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev/testing)
# PostgreSQL Example:
# DATABASE_URL=postgresql://insightops:insightops_password@localhost:5432/insightops_db
# SQLite Local Dev Default:
DATABASE_URL=sqlite:///./data/insightops.db

# JWT Authentication Security (HS256)
JWT_SECRET_KEY=insightops-secret-key-change-in-production-2026-bi-saas-enterprise
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional LLM / AI Analyst Providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=
